# The same loss across a leader change: acknowledged by n1 in term 2, then a
# read on the new leader n2 in term 3 does not see it — the signature of a
# write acknowledged before it was committed.
1 c1 put "k" 1 2 ok value="A" node=n1 term=2 index=4
2 c1 put "k" 3 4 ok value="B" node=n1 term=2 index=5
3 c2 get "k" 5 6 ok output="A" node=n2 term=3 index=6
