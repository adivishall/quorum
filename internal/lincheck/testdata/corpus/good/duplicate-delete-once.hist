# A DELETE retried after another client's PUT: deduplicated, the retry removes
# nothing, the final read sees B.
1 c2 put "k" 1 2 ok value="X"
2 c1 delete "k" 3 0 incomplete cid=1 rid=4
3 c3 get "k" 4 5 notfound
4 c2 put "k" 6 7 ok value="B"
5 c3 get "k" 8 9 ok output="B"
6 c1 delete "k" 10 11 ok cid=1 rid=4
7 c3 get "k" 12 13 ok output="B"
